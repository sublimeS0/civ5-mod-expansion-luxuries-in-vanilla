                <Sequence type="trigger_timeline">
                  <TriggerTimelineSequence ec="1000">
                    <SequenceInfo duration="0.000000" speed="1.000000" loop="true" />
                  </TriggerTimelineSequence>
                </Sequence>
              </Item>
            </Items>
          </Item>
          <Item type="selector">
            <!-- Pillaged State -->
